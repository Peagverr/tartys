{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tartys",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "d1_databases": [
    // database_id — из `wrangler d1 create tartys` (см. README → Деплой).
    { "binding": "DB", "database_name": "tartys", "database_id": "403f28b3-6701-44d0-a5f0-9fbcbe9e428a" }
  ]
}
