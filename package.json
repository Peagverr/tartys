{
  "name": "tartys",
  "private": true,
  "version": "1.0.0",
  "description": "Тартыс — перетягивание каната, где побеждает тот, кто читает соперника: Рывок, Упор, Передышка",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "dev:worker": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "node scripts/copy-mediapipe.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "qrcode": "^1.5.4"
  }
}
